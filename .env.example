# Copy to .env and adjust before running locally.
# Never commit a filled-in copy of this file.

ENVIRONMENT=development
APP_URL=http://localhost:5173

# Strong random value. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=60
COOKIE_SECURE=false

# PostgreSQL is recommended in production. SQLite works out of the box locally.
DATABASE_URL=sqlite:///./data/quotient.db
# DATABASE_URL=postgresql+psycopg://quotient:quotient@localhost:5432/quotient

# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to the number of reverse proxies in front of the app before trusting X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# File uploads
MAX_UPLOAD_BYTES=2097152
MAX_REQUEST_BYTES=8388608

# Payments. Use "mock" for local development, "stripe" for production.
PAYMENTS_PROVIDER=mock
MOCK_WEBHOOK_SECRET=replace-me-too
PLAN_PRICE_CENTS=1900
PLAN_CURRENCY=usd

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Comma separated list of emails that are granted the administrator role on sign up.
ADMIN_EMAILS=

LOG_LEVEL=INFO
